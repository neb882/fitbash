{
  "name": "fitbash",
  "version": "0.1.0",
  "private": true,
  "description": "Outfit maker: paste clothing pictures or links, get one generated picture of the complete outfit.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser/*.test.js",
    "test:all": "node --test test/*.test.js test/browser/*.test.js",
    "vendor": "sh scripts/vendor.sh"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@axe-core/playwright": "4.14.1",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0"
  }
}
