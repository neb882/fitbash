# Copy to .env and fill in. Never commit .env.

# Which image model makes the outfit picture: mock | gemini | openai
# "mock" needs no key and returns a plain collage, so the app runs out of the box.
FITBASH_PROVIDER=mock

# Google Gemini API key (FITBASH_PROVIDER=gemini)
GEMINI_API_KEY=
# FITBASH_GEMINI_MODEL=gemini-nano-banana-2.1

# OpenAI API key (FITBASH_PROVIDER=openai)
OPENAI_API_KEY=
# FITBASH_OPENAI_MODEL=gpt-image-2.5-sunburst
# FITBASH_OPENAI_QUALITY=medium

# Optional: a Claude key turns on the quality check. Claude compares each
# generated picture with your items and asks for a redo when a piece is
# missing or its print got mangled.
ANTHROPIC_API_KEY=
# FITBASH_CRITIC_MODEL=claude-opus-5-5
# Most pictures generated per request, counting redos (1 turns redos off).
# FITBASH_MAX_ATTEMPTS=2

# Optional: require this code in the page before anyone can spend your keys.
# Set it whenever the app is reachable from the internet.
FITBASH_ACCESS_CODE=

# PORT=3000
